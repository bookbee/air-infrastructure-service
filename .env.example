# air-infrastructure-service settings. Copy to .env for local dev (`make env`).
# Every key is prefixed with the service name; nested groups use a
# double-underscore delimiter: AIR_INFRASTRUCTURE_SERVICE__REDIS__URL.

# ---- core ------------------------------------------------------------------
AIR_INFRASTRUCTURE_SERVICE__ENVIRONMENT=local          # local | staging | prod
AIR_INFRASTRUCTURE_SERVICE__API__HOST=0.0.0.0
AIR_INFRASTRUCTURE_SERVICE__API__PORT=8080
AIR_INFRASTRUCTURE_SERVICE__LOG__LEVEL=INFO
AIR_INFRASTRUCTURE_SERVICE__LOG__RENDER=console        # console | json (json in prod)

# Comma-separated "token:service" pairs this service accepts (one per token).
# In prod these come from the secret backend, never from .env.
AIR_INFRASTRUCTURE_SERVICE__SECURITY__SERVICE_TOKENS=air-classifier-dev:air-classifier,air-platform-dev:air-platform,air-client-dev:air-client
AIR_INFRASTRUCTURE_SERVICE__SECURITY__SECRET_BACKEND=env   # env | file | vault

# ---- data stores (endpoints the broker hands out) --------------------------
# Hostnames below are the compose service names; override for prod.
AIR_INFRASTRUCTURE_SERVICE__REDIS__URL=redis://:localdevpass@redis:6379/0

AIR_INFRASTRUCTURE_SERVICE__POSTGRES__HOST=pgbouncer
AIR_INFRASTRUCTURE_SERVICE__POSTGRES__PORT=6432
AIR_INFRASTRUCTURE_SERVICE__POSTGRES__DB=air
AIR_INFRASTRUCTURE_SERVICE__POSTGRES__USER=air
AIR_INFRASTRUCTURE_SERVICE__POSTGRES__PASSWORD=localdevpass

AIR_INFRASTRUCTURE_SERVICE__MONGO__URI=mongodb://air:localdevpass@mongo:27017
AIR_INFRASTRUCTURE_SERVICE__MONGO__DB=air

# ---- policy / limits -------------------------------------------------------
AIR_INFRASTRUCTURE_SERVICE__POLICY__CONFIG_PATH=deploy/policy/policy.local.yaml
AIR_INFRASTRUCTURE_SERVICE__POLICY__DEFAULT_RATE_PER_MINUTE=120
